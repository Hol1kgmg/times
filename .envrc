use flake .
# デプロイ先が異なるため、backend (Cloud Run) と frontend (Workers) の環境変数を分ける
for f in backend/.env frontend/.env; do
  watch_file "$f" "$f.keys"
  # 鍵が無いと暗号文のまま入るので読まない。--overload は direnv の再読み込み前の値を優先させないため
  [ -f "$f.keys" ] || continue
  dotenv_exports=$(dotenvx get -f "$f" -fk "$f.keys" --strict --overload -ek DOTENV_PUBLIC_KEY --format eval-export) || return 1
  eval "$dotenv_exports"
done

# portless を sudo なしで動かすため、root 権限が要る処理（1024 未満の待ち受け・/etc/hosts 書き込み・CA 登録）を止める
export PORTLESS_PORT=1355
export PORTLESS_SYNC_HOSTS=0
export PORTLESS_HTTPS=0
