{
  "name": "times-frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:host": "vite dev --port 3000 --host 0.0.0.0",
    "generate-routes": "tsr generate",
    "generate-api": "openapi-typescript ../backend/api/openapi.yaml -o src/shared/api/openapi.gen.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "ultracite check --type-aware",
    "lint:markup": "markuplint \"src/**/*.tsx\" --problem-only",
    "format": "ultracite fix --type-aware",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium && pnpm generate-api"
  },
  "dependencies": {
    "@fontsource/klee-one": "^5.3.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@markuplint/jsx-parser": "^5.0.1",
    "@markuplint/react-spec": "^5.0.1",
    "@playwright/test": "^1.64.0",
    "@tanstack/router-cli": "1.167.40",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "jsdom": "^30.1.2",
    "markuplint": "^5.0.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "postcss-custom-media": "^12.0.3",
    "typescript": "^6.0.2",
    "ultracite": "^7.12.4",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
