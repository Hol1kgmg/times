{
  "name": "times-frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:host": "vite dev --port 3000 --host 0.0.0.0",
    "generate-routes": "tsr generate",
    "generate-api": "openapi-typescript ../backend/api/openapi.yaml -o src/shared/api/openapi.gen.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright install chromium && playwright test",
    "test:e2e:ui": "playwright install chromium && playwright test --ui",
    "lint": "ultracite check --type-aware",
    "lint:markup": "markuplint \"src/**/*.tsx\" --problem-only",
    "format": "ultracite fix --type-aware",
    "typecheck": "tsc --noEmit",
    "postinstall": "pnpm generate-api"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.2",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/helpers": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@fontsource/klee-one": "^5.3.1",
    "@internationalized/date": "^3.12.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/router-plugin": "1.168.48",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "temporal-polyfill": "^1.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@markuplint/jsx-parser": "^5.4.0",
    "@markuplint/react-spec": "^5.4.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/router-cli": "1.167.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.1.0",
    "jsdom": "^30.1.3",
    "markuplint": "^5.4.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss-custom-media": "^12.0.3",
    "typescript": "^6.0.2",
    "ultracite": "^8.1.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
