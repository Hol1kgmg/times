{
  "name": "times-frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:host": "vite dev --port 3000 --host 0.0.0.0",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "ultracite check --type-aware",
    "lint:markup": "markuplint \"src/**/*.tsx\" --fix --problem-only",
    "format": "ultracite fix --type-aware",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource/klee-one": "^5.3.0",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.56",
    "@tanstack/router-plugin": "1.168.40",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@markuplint/jsx-parser": "^5.0.0",
    "@markuplint/react-spec": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/router-cli": "1.167.38",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "jsdom": "^30.0.1",
    "markuplint": "^5.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "postcss-custom-media": "^12.0.1",
    "typescript": "^6.0.2",
    "ultracite": "^7.12.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.133.0"
  }
}
