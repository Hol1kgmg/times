{
  "name": "times-frontend",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#/*": "./src/*",
    "#storybook/*": "./.storybook/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:host": "vite dev --port 3000 --host 0.0.0.0",
    "generate-routes": "tsr generate",
    "generate-api": "openapi-typescript ../backend/api/openapi.yaml -o src/shared/api/openapi.gen.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "mutator",
    "test:e2e": "playwright install chromium && playwright test",
    "test:e2e:ui": "playwright install chromium && playwright test --ui",
    "lint": "ultracite check --type-aware",
    "lint:markup": "markuplint \"src/**/*.tsx\" --problem-only",
    "format": "ultracite fix --type-aware",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "postinstall": "pnpm generate-api"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.6",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/helpers": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@fontsource/klee-one": "^5.3.1",
    "@internationalized/date": "^3.12.4",
    "@praha/byethrow": "^0.13.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.6",
    "@tanstack/router-plugin": "1.169.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "temporal-polyfill": "^1.0.8",
    "three": "~0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@markuplint/jsx-parser": "^5.6.1",
    "@markuplint/react-spec": "^5.6.1",
    "@mizchi/mutator": "0.4.5",
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "^10.6.7",
    "@tanstack/router-cli": "1.168.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
    "jsdom": "^31.0.1",
    "markuplint": "^5.6.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "postcss-custom-media": "^12.0.4",
    "storybook": "^10.6.7",
    "typescript": "^6.0.2",
    "ultracite": "^8.3.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "webmcp-types": "0.1.11",
    "wrangler": "^4.165.0"
  }
}
