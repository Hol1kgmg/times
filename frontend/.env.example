# frontend/.env にコピーして埋める (gitignore 済み)。手順: docs/admin-login.md
# ルートの .envrc (direnv) が読み、`just fe-dev` に届く。Vite の import.meta.env には載せない (サーバー側で process.env を読む)。本番は Workers ダッシュボードの Variables
# openssl rand -hex 16
ADMIN_LOGIN_PATH=
# backend/.env と同じ値
GITHUB_CLIENT_ID=
# 任意 (テストでモックへ向ける)
GITHUB_BASE_URL=
# 任意 (既定: http://localhost:8080 / なし)
BACKEND_URL=
BACKEND_TOKEN=
