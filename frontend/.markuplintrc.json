{
  "extends": ["markuplint:recommended"],
  "parser": {
    ".tsx": "@markuplint/jsx-parser"
  },
  "specs": {
    ".tsx": "@markuplint/react-spec"
  },
  "pretenders": [{ "selector": "Dialog", "as": "dialog" }],
  "rules": {
    "case-sensitive-attr-name": false,
    "security/no-event-handler-attr": false,
    "no-unknown-attr": {
      "options": {
        "allowAttrs": ["onPointerDown", "onPointerDownCapture", "onPointerMove", "onKeyDownCapture"]
      }
    }
  },
  "overrides": {
    "src/app/routes/__root.tsx": {
      "rules": {
        "permitted-contents": false,
        "required-element": false
      }
    }
  }
}
